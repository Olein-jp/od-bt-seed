{
	"$schema": "https://schemas.wp.org/wp/7.1/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultGradients": false,
			"defaultPalette": false,
			"palette": [
				{ "name": "Base", "slug": "base", "color": "#fbfbfa" },
				{ "name": "Contrast", "slug": "contrast", "color": "#161918" },
				{ "name": "Muted", "slug": "muted", "color": "#4b5550" },
				{ "name": "Surface", "slug": "surface", "color": "#ebefec" },
				{ "name": "Accent", "slug": "accent", "color": "#265443" }
			]
		},
		"layout": {
			"contentSize": "720px",
			"wideSize": "1120px"
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "name": "Extra small", "slug": "20", "size": "0.5rem" },
				{ "name": "Small", "slug": "30", "size": "0.875rem" },
				{ "name": "Medium", "slug": "40", "size": "clamp(1rem, 2.5vw, 1.5rem)" },
				{ "name": "Large", "slug": "50", "size": "clamp(1.5rem, 4vw, 2.5rem)" },
				{ "name": "Extra large", "slug": "60", "size": "clamp(2.5rem, 6vw, 4rem)" }
			],
			"units": ["px", "rem", "em", "%", "vw"]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"name": "System sans-serif",
					"slug": "system-sans",
					"fontFamily": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
				}
			],
			"fontSizes": [
				{ "name": "Small", "slug": "small", "size": "0.875rem", "fluid": false },
				{ "name": "Medium", "slug": "medium", "size": "1rem", "fluid": false },
				{
					"name": "Large",
					"slug": "large",
					"size": "1.25rem",
					"fluid": { "min": "1.125rem", "max": "1.25rem" }
				},
				{
					"name": "Extra large",
					"slug": "x-large",
					"size": "1.75rem",
					"fluid": { "min": "1.5rem", "max": "1.75rem" }
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "2.5rem",
					"fluid": { "min": "1.875rem", "max": "2.5rem" }
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var:preset|color|base",
			"text": "var:preset|color|contrast"
		},
		"spacing": {
			"blockGap": "var:preset|spacing|40",
			"padding": {
				"top": "0",
				"right": "var:preset|spacing|40",
				"bottom": "0",
				"left": "var:preset|spacing|40"
			}
		},
		"typography": {
			"fontFamily": "var:preset|font-family|system-sans",
			"fontSize": "var:preset|font-size|medium",
			"lineHeight": "1.75"
		},
		"elements": {
			"heading": {
				"typography": { "fontWeight": "650", "lineHeight": "1.3" }
			},
			"h1": {
				"typography": { "fontSize": "var:preset|font-size|display" }
			},
			"h2": {
				"typography": { "fontSize": "var:preset|font-size|x-large" }
			},
			"h3": {
				"typography": { "fontSize": "var:preset|font-size|large" }
			},
			"link": {
				"color": { "text": "var:preset|color|accent" },
				"typography": { "textDecoration": "underline" }
			},
			"button": {
				"border": { "radius": "0.25rem" },
				"color": {
					"background": "var:preset|color|accent",
					"text": "var:preset|color|base"
				},
				"spacing": {
					"padding": {
						"top": "var:preset|spacing|20",
						"right": "var:preset|spacing|40",
						"bottom": "var:preset|spacing|20",
						"left": "var:preset|spacing|40"
					}
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "var:preset|font-size|small" }
			}
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
